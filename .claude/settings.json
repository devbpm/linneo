{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/docs-gate.sh\"",
            "statusMessage": "Checking docs are in sync with the library..."
          }
        ]
      }
    ]
  }
}
